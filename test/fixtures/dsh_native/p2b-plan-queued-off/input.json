{
  "config": {
    "approvalPolicy": "never"
  },
  "steps": [
    {
      "op": "initialize"
    },
    {
      "op": "newSession",
      "workspace": {
        "note.txt": "one\n"
      }
    },
    {
      "op": "prompt",
      "text": "Summarize the repository."
    },
    {
      "op": "command",
      "text": "/plan"
    },
    {
      "op": "prompt",
      "text": "Read the note.",
      "commandDuringTurn": "/plan off"
    }
  ]
}
